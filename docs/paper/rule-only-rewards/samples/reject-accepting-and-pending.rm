REWARD_MACHINE:
STATES: u0, u1
INITIAL_STATE: u0
FINAL_STATES:
ACCEPTING_STATES: u0, u1
DEFAULT_REWARD: 0
HARD_FAILED_REWARD: -1
SOFT_FAILED_REWARD: -0.5
TRANSITION_FUNCTION:
(u0, box_fell&!box_on_shelf) -> u1
(u1, box_on_shelf) -> u0
REWARD_FUNCTION:
(u0, box_fell&!box_on_shelf, u1) -> -0.1
(u1, box_on_shelf, u0) -> 0.1
PENDING_PROMISES:
u1: hard 1, soft 0
