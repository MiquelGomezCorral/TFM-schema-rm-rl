(u0, at_goal&has_key&!key_lost) -> u5
(u0, at_goal&has_key&key_lost) -> u4
(u1, !at_goal&!has_key&key_lost) -> u2
(u1, !at_goal&has_key&!key_lost) -> u3
(u1, !at_goal&has_key&key_lost) -> u4
(u1, at_goal&!has_key&!key_lost) -> u5
(u1, at_goal&!has_key&key_lost) -> u5
(u1, at_goal&has_key&!key_lost) -> u5
(u1, at_goal&has_key&key_lost) -> u4
(u2, !at_goal&has_key) -> u4
(u2, at_goal&!has_key) -> u5
(u2, at_goal&has_key) -> u4
(u3, !at_goal&key_lost) -> u4
(u3, at_goal&!key_lost) -> u5
(u3, at_goal&key_lost) -> u4
REWARD_FUNCTION:
(u0, !at_goal&!has_key&key_lost, u2) -> 0.1
(u0, !at_goal&has_key&!key_lost, u3) -> 0.1
(u0, !at_goal&has_key&key_lost, u4) -> -1
(u0, at_goal&!has_key&!key_lost, u5) -> 1.2
(u0, at_goal&!has_key&key_lost, u5) -> 1.2
(u0, at_goal&has_key&!key_lost, u5) -> 1.2
(u0, at_goal&has_key&key_lost, u4) -> -1
(u1, !at_goal&!has_key&key_lost, u2) -> 0.1
(u1, !at_goal&has_key&!key_lost, u3) -> 0.1
(u1, !at_goal&has_key&key_lost, u4) -> -1
(u1, at_goal&!has_key&!key_lost, u5) -> 1.2
(u1, at_goal&!has_key&key_lost, u5) -> 1.2
(u1, at_goal&has_key&!key_lost, u5) -> 1.2
(u1, at_goal&has_key&key_lost, u4) -> -1
(u2, !at_goal&has_key, u4) -> -1
(u2, at_goal&!has_key, u5) -> 1.1
(u2, at_goal&has_key, u4) -> -1
(u3, !at_goal&key_lost, u4) -> -1
(u3, at_goal&!key_lost, u5) -> 1.1
(u3, at_goal&key_lost, u4) -> -1
