REWARD_MACHINE:
STATES: u0, u1, u2, u3, u4, u5
INITIAL_STATE: u0
FINAL_STATES: u5
REJECTING_STATES: u4
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&!has_key&!key_lost) -> u1
(u0, !at_goal&!has_key&key_lost) -> u2
(u0, !at_goal&has_key&!key_lost) -> u3
(u0, !at_goal&has_key&key_lost) -> u4
(u0, at_goal&!has_key&!key_lost) -> u5
