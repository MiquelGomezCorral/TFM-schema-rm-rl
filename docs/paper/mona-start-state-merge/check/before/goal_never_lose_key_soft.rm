REWARD_MACHINE:
STATES: u0, u1, u2, u3
INITIAL_STATE: u0
FINAL_STATES: u3
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&!key_lost) -> u1
(u0, !at_goal&key_lost) -> u2
(u0, at_goal&!key_lost) -> u3
(u0, at_goal&key_lost) -> u3
(u1, !at_goal&key_lost) -> u2
(u1, at_goal&!key_lost) -> u3
(u1, at_goal&key_lost) -> u3
(u2, at_goal) -> u3
REWARD_FUNCTION:
(u0, !at_goal&key_lost, u2) -> -0.4
(u0, at_goal&!key_lost, u3) -> 1.45
(u0, at_goal&key_lost, u3) -> 0.7
(u1, !at_goal&key_lost, u2) -> -0.4
(u1, at_goal&!key_lost, u3) -> 1.45
(u1, at_goal&key_lost, u3) -> 0.7
(u2, at_goal, u3) -> 1.1
