REWARD_MACHINE:
STATES: u0, u1, u2
INITIAL_STATE: u0
FINAL_STATES: u2
REJECTING_STATES: u1
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&key_lost) -> u1
(u0, at_goal&!key_lost) -> u2
(u0, at_goal&key_lost) -> u1
REWARD_FUNCTION:
(u0, !at_goal&key_lost, u1) -> -1
(u0, at_goal&!key_lost, u2) -> 1.1
(u0, at_goal&key_lost, u1) -> -1
