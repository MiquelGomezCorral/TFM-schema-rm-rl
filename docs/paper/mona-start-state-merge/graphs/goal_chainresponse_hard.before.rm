REWARD_MACHINE:
STATES: u0, u1, u2, u3, u4, u5
INITIAL_STATE: u0
FINAL_STATES: u3
REJECTING_STATES: u5
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&!has_key) -> u1
(u0, !at_goal&has_key) -> u2
(u0, at_goal&!has_key) -> u3
(u0, at_goal&has_key) -> u4
(u1, !at_goal&has_key) -> u2
(u1, at_goal&!has_key) -> u3
(u1, at_goal&has_key) -> u4
(u2, !at_goal&!door_open) -> u5
(u2, !at_goal&door_open&!has_key) -> u1
(u2, at_goal&!door_open) -> u5
(u2, at_goal&door_open&!has_key) -> u3
(u2, at_goal&door_open&has_key) -> u4
(u4, !door_open) -> u5
(u4, door_open&!has_key) -> u3
REWARD_FUNCTION:
(u0, at_goal&!has_key, u3) -> 1.2
(u0, at_goal&has_key, u4) -> 0.1
(u1, at_goal&!has_key, u3) -> 1.2
(u1, at_goal&has_key, u4) -> 0.1
(u2, !at_goal&!door_open, u5) -> -1
(u2, at_goal&!door_open, u5) -> -1
(u2, at_goal&door_open&!has_key, u3) -> 1.2
(u2, at_goal&door_open&has_key, u4) -> 0.1
(u4, !door_open, u5) -> -1
(u4, door_open&!has_key, u3) -> 1.1
