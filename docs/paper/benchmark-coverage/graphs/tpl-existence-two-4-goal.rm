REWARD_MACHINE:
STATES: u0, u1, u2, u3, u4, u5
INITIAL_STATE: u0
FINAL_STATES: u5
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_exit&holding_box) -> u1
(u0, at_exit&!holding_box) -> u2
(u0, at_exit&holding_box) -> u3
(u1, !at_exit&holding_box) -> u4
(u1, at_exit&!holding_box) -> u3
(u1, at_exit&holding_box) -> u5
(u2, holding_box) -> u3
(u3, holding_box) -> u5
(u4, at_exit) -> u5
REWARD_FUNCTION:
(u0, !at_exit&holding_box, u1) -> 1
(u0, at_exit&!holding_box, u2) -> 1
(u0, at_exit&holding_box, u3) -> 2
(u1, !at_exit&holding_box, u4) -> 1
(u1, at_exit&!holding_box, u3) -> 1
(u1, at_exit&holding_box, u5) -> 12
(u2, holding_box, u3) -> 1
(u3, holding_box, u5) -> 11
(u4, at_exit, u5) -> 11
