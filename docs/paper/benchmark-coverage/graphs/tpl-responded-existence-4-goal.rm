(u0, at_exit&siren_ringing&!switch_toggled) -> u4
(u0, at_exit&siren_ringing&switch_toggled) -> u3
(u1, at_exit) -> u3
(u2, !at_exit&switch_toggled) -> u1
(u2, at_exit&!switch_toggled) -> u4
(u2, at_exit&switch_toggled) -> u3
(u4, switch_toggled) -> u3
REWARD_FUNCTION:
(u0, !at_exit&siren_ringing&!switch_toggled, u2) -> -1
(u0, at_exit&!siren_ringing&!switch_toggled, u3) -> 11
