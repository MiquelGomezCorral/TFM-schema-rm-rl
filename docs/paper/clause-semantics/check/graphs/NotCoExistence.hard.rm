REWARD_MACHINE:
STATES: u0, u1, u2, u3
INITIAL_STATE: u0
FINAL_STATES:
REJECTING_STATES: u3
ACCEPTING_STATES: u0, u1, u2
DEFAULT_REWARD: 0
HARD_FAILED_REWARD: -1
SOFT_FAILED_REWARD: -0.5
TRANSITION_FUNCTION:
(u0, !has_key&key_lost) -> u1
(u0, has_key&!key_lost) -> u2
(u0, has_key&key_lost) -> u3
(u1, has_key) -> u3
(u2, key_lost) -> u3
REWARD_FUNCTION:
(u0, has_key&key_lost, u3) -> -1
(u1, has_key, u3) -> -1
(u2, key_lost, u3) -> -1
PENDING_PROMISES:
