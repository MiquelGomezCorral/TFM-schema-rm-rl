REWARD_MACHINE:
STATES: u0, u1, u2, u3, u4
INITIAL_STATE: u0
FINAL_STATES: u2
REJECTING_STATES: u4
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&has_key) -> u1
(u0, at_goal&!has_key) -> u2
(u0, at_goal&has_key) -> u3
(u1, !at_goal&!door_open) -> u4
(u1, !at_goal&door_open&!has_key) -> u0
(u1, at_goal&!door_open) -> u4
(u1, at_goal&door_open&!has_key) -> u2
(u1, at_goal&door_open&has_key) -> u3
(u3, !door_open) -> u4
(u3, door_open&!has_key) -> u2
REWARD_FUNCTION:
(u0, at_goal&!has_key, u2) -> 1.2
(u0, at_goal&has_key, u3) -> 0.1
(u1, !at_goal&!door_open, u4) -> -1
(u1, at_goal&!door_open, u4) -> -1
(u1, at_goal&door_open&!has_key, u2) -> 1.2
(u1, at_goal&door_open&has_key, u3) -> 0.1
(u3, !door_open, u4) -> -1
(u3, door_open&!has_key, u2) -> 1.1
