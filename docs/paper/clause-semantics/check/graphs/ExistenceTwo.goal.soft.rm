REWARD_MACHINE:
STATES: u0, u1, u2, u3
INITIAL_STATE: u0
FINAL_STATES: u2
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&door_open) -> u1
(u0, at_goal&!door_open) -> u2
(u0, at_goal&door_open) -> u2
(u1, !at_goal&door_open) -> u3
(u1, at_goal&!door_open) -> u2
(u1, at_goal&door_open) -> u2
(u3, at_goal) -> u2
REWARD_FUNCTION:
(u0, !at_goal&door_open, u1) -> 0.1
(u0, at_goal&!door_open, u2) -> 0.8
(u0, at_goal&door_open, u2) -> 0.8
(u1, !at_goal&door_open, u3) -> 0.1
(u1, at_goal&!door_open, u2) -> 0.7
(u1, at_goal&door_open, u2) -> 1.2
(u3, at_goal, u2) -> 1.1
