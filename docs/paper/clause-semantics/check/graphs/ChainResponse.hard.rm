REWARD_MACHINE:
STATES: u0, u1, u2
INITIAL_STATE: u0
FINAL_STATES:
REJECTING_STATES: u2
ACCEPTING_STATES: u0
DEFAULT_REWARD: 0
HARD_FAILED_REWARD: -1
SOFT_FAILED_REWARD: -0.5
TRANSITION_FUNCTION:
(u0, has_key) -> u1
(u1, !door_open) -> u2
(u1, door_open&!has_key) -> u0
REWARD_FUNCTION:
(u0, has_key, u1) -> -0.1
(u1, !door_open, u2) -> -1
(u1, door_open&!has_key, u0) -> 0.1
PENDING_PROMISES:
u1: hard 1, soft 0
