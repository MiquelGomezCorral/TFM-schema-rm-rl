REWARD_MACHINE:
STATES: u0, u1, u2
INITIAL_STATE: u0
FINAL_STATES:
REJECTING_STATES: u2
ACCEPTING_STATES: u0, u1
DEFAULT_REWARD: 0
HARD_FAILED_REWARD: -1
SOFT_FAILED_REWARD: -0.5
TRANSITION_FUNCTION:
(u0, !door_open&has_key) -> u1
(u0, door_open) -> u2
REWARD_FUNCTION:
(u0, door_open, u2) -> -1
PENDING_PROMISES:
