REWARD_MACHINE:
STATES: u0, u1, u2
INITIAL_STATE: u0
FINAL_STATES:
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !door_open&has_key) -> u1
(u1, !door_open) -> u2
(u1, door_open) -> u0
(u2, !door_open&!has_key) -> u0
(u2, !door_open&has_key) -> u1
(u2, door_open) -> u0
REWARD_FUNCTION:
(u0, !door_open&has_key, u1) -> -0.1
(u1, !door_open, u2) -> -0.4
(u1, door_open, u0) -> 0.1
(u2, !door_open&has_key, u1) -> -0.1
