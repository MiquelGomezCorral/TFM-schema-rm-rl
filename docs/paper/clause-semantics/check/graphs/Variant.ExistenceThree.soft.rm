REWARD_MACHINE:
STATES: u0, u1, u2, u3
INITIAL_STATE: u0
FINAL_STATES:
ACCEPTING_STATES: u3
DEFAULT_REWARD: 0
HARD_FAILED_REWARD: -1
SOFT_FAILED_REWARD: -0.5
TRANSITION_FUNCTION:
(u0, door_open) -> u1
(u1, door_open) -> u2
(u2, door_open) -> u3
REWARD_FUNCTION:
(u0, door_open, u1) -> 0.1
(u1, door_open, u2) -> 0.1
(u2, door_open, u3) -> 0.1
PENDING_PROMISES:
u0: hard 0, soft 1
u1: hard 0, soft 1
u2: hard 0, soft 1
