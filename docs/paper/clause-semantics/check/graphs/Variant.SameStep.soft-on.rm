REWARD_MACHINE:
STATES: u0, u1
INITIAL_STATE: u0
FINAL_STATES:
ACCEPTING_STATES: u0, u1
DEFAULT_REWARD: 0
HARD_FAILED_REWARD: -1
SOFT_FAILED_REWARD: -0.5
TRANSITION_FUNCTION:
(u0, has_key&key_lost) -> u1
(u1, !has_key) -> u0
(u1, has_key&!key_lost) -> u0
REWARD_FUNCTION:
(u0, has_key&key_lost, u1) -> -0.5
PENDING_PROMISES:
