REWARD_MACHINE:
STATES: u0, u1, u2, u3
INITIAL_STATE: u0
FINAL_STATES:
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !has_key&key_lost) -> u1
(u0, has_key&!key_lost) -> u2
(u0, has_key&key_lost) -> u3
(u1, has_key) -> u3
(u2, key_lost) -> u3
(u3, !has_key&!key_lost) -> u0
(u3, !has_key&key_lost) -> u1
(u3, has_key&!key_lost) -> u2
REWARD_FUNCTION:
(u0, has_key&key_lost, u3) -> -0.5
(u1, has_key, u3) -> -0.5
(u2, key_lost, u3) -> -0.5
