REWARD_MACHINE:
STATES: u0, u1, u2
INITIAL_STATE: u0
FINAL_STATES:
ACCEPTING_STATES: u0, u1, u2
DEFAULT_REWARD: 0
HARD_FAILED_REWARD: -1
SOFT_FAILED_REWARD: -0.5
TRANSITION_FUNCTION:
(u0, !door_open&has_key) -> u1
(u0, door_open) -> u2
(u2, !door_open&!has_key) -> u0
(u2, !door_open&has_key) -> u1
REWARD_FUNCTION:
(u0, door_open, u2) -> -0.5
PENDING_PROMISES:
