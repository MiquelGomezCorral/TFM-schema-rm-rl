REWARD_MACHINE:
STATES: u0, u1, u2, u3, u4, u5
INITIAL_STATE: u0
FINAL_STATES: u5
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&door_open) -> u1
(u0, at_goal&!door_open) -> u2
(u0, at_goal&door_open) -> u3
(u1, !at_goal&door_open) -> u4
(u1, at_goal&!door_open) -> u3
(u1, at_goal&door_open) -> u5
(u2, door_open) -> u3
(u3, door_open) -> u5
(u4, at_goal) -> u5
REWARD_FUNCTION:
(u0, !at_goal&door_open, u1) -> 0.1
(u0, at_goal&!door_open, u2) -> 0.1
(u0, at_goal&door_open, u3) -> 0.2
(u1, !at_goal&door_open, u4) -> 0.1
(u1, at_goal&!door_open, u3) -> 0.1
(u1, at_goal&door_open, u5) -> 1.2
(u2, door_open, u3) -> 0.1
(u3, door_open, u5) -> 1.1
(u4, at_goal, u5) -> 1.1
