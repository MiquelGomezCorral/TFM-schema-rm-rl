+"""Exact clues for the critic, computed from a candidate's clauses, clause DFAs and machine.
+
+Three clues, no LLM call: each clause in plain words, the hard clauses the other hard clauses
+already imply, and the events every finishing run contains. They know the clauses, not the level:
+a path they show may be impossible there.
+"""
+
+import itertools
+from collections import deque
+from collections.abc import Callable, Sequence
+from functools import cache
+
+from src.config import PriorityLevel
+
+from .pipeline import ClauseProposal
+from .reward_layer import ClauseState, clause_labels
+from .reward_machine import RewardMachineStructure, evaluate_boolean_guard, parse_boolean_guard
+
+PLAIN = {
+    "Existence": "{0} happens at least once",
+    "ExistenceTwo": "{0} happens on at least two different steps",
+    "Absence": "{0} never happens",
+    "Response": "every {0} is followed by {1}, on that step or later",
+    "ChainResponse": "every {0} is followed by {1} on the very next step",
+    "Precedence": "{1} may not happen before the first {0}",
+    "RespondedExistence": "if {0} happens, {1} happens too, before or after",
+    "NotCoExistence": "{0} and {1} never both happen in one episode",
+}
+
+# Every event set of the propositions, the product of the clause DFAs and the machine's finish are
+# walked explicitly.
+MAX_PROPOSITIONS = 12
+
+
+# ======================================================================================
+#                                      CLAUSE DFAS
+# ======================================================================================
+
+
+class _Dfa:
+    """One clause DFA with its guards parsed and each state labeled."""
+
+    def __init__(self, dfa: dict):
+        self.initial = dfa["initial_state"]
+        self.labels = clause_labels(dfa)
+        self.own = sorted(dfa["alphabet"])
+        self.rows: dict[str, list] = {}
+        for (source, guard), destination in dfa["transitions"].items():
+            self.rows.setdefault(source, []).append(
+                (parse_boolean_guard(guard, self.own), destination)
+            )
+        # The empty trace is no run: the start takes the label of the state after one empty step.
+        self.start_label = self.labels[self.step(self.initial, frozenset())]
+
+    def label(self, state: str) -> ClauseState:
+        return self.start_label if state == self.initial else self.labels[state]
+
+    def step(self, state: str, valuation: frozenset[str]) -> str:
+        values = {proposition: proposition in valuation for proposition in self.own}
+        for guard, destination in self.rows[state]:
+            if evaluate_boolean_guard(guard, values):
+                return destination
+        raise ValueError("incomplete DFA")
+
+
+def _valuations(alphabet: Sequence[str]) -> list[frozenset[str]]:
+    """Every event set, smallest first, so the first match has the fewest events."""
+    return [
+        frozenset(events)
+        for size in range(len(alphabet) + 1)
+        for events in itertools.combinations(alphabet, size)
+    ]
+
+
+def _singles(alphabet: Sequence[str]) -> list[frozenset[str]]:
+    """At most one event per step: the paths an agent usually walks."""
+    return [frozenset(), *(frozenset([proposition]) for proposition in alphabet)]
+
+
+def _bfs(start: str, step: Callable, valuations: Sequence[frozenset[str]], goal: Callable):
+    """The shortest valuation path from ``start`` to a state where ``goal`` holds, or None."""
+    seen = {start: None}
+    queue = deque([start])
+    while queue:
+        state = queue.popleft()
+        if goal(state) and seen[state] is not None:
+            path = []
+            while seen[state] is not None:
+                state, valuation = seen[state]
+                path.append(valuation)
+            return path[::-1]
+        for valuation in valuations:
+            following = step(state, valuation)
+            if following not in seen:
+                seen[following] = (state, valuation)
+                queue.append(following)
+    return None
+
+
+def _walk(start, step, alphabet, valuations, goal):
+    """The shortest path with one event per step, else with any event sets."""
+    return _bfs(start, step, _singles(alphabet), goal) or _bfs(start, step, valuations, goal)
+
+
+# ======================================================================================
+#                                         CLUES
+# ======================================================================================
+
+
+def _name(clause: ClauseProposal) -> str:
+    return f"{clause.pattern}({', '.join(clause.propositions)})"
+
+
+def _path_text(path: Sequence[frozenset[str]]) -> str:
+    return ", then ".join(
+        "+".join(sorted(valuation)) if valuation else "(a step with none of these events)"
+        for valuation in path
+    )
+
+
+def _plain_line(
+    number: int,
+    clause: ClauseProposal,
+    dfa: _Dfa,
+    alphabet: Sequence[str],
+    valuations: Sequence[frozenset[str]],
+) -> str:
+    def reach(start: str, label: ClauseState):
+        return _walk(start, dfa.step, alphabet, valuations, lambda s: dfa.label(s) is label)
+
+    broken = reach(dfa.initial, ClauseState.VIOLATED)
+    if broken:
+        how = f"broken for good by: {_path_text(broken)}"
+    elif dfa.start_label is ClauseState.PENDING:
+        how = "owed from the start until it is met"
+    else:
+        owed = reach(dfa.step(dfa.initial, frozenset()), ClauseState.PENDING)
+        how = f"owed after: {_path_text(owed)}" if owed else "never owed"
+
+    if clause.priority is not PriorityLevel.HARD:
+        cost = "soft: a break costs a penalty and the episode goes on"
+    elif broken:
+        cost = "a hard break fails the episode"
+    else:
+        cost = "hard: still owed when the episode ends = failed"
+
+    meaning = PLAIN[clause.pattern].format(*clause.propositions)
+    return f"- R{number} {clause.priority.value} {_name(clause)}: {meaning}; {how}; {cost}."
+
+
+def _redundant_lines(
+    clauses: Sequence[ClauseProposal],
+    automata: Sequence[_Dfa],
+    hard: Sequence[int],
+    valuations: Sequence[frozenset[str]],
+) -> list[str]:
+    """Name each hard clause the other hard clauses already imply, or say there is none.
+
+    A clause is implied when no state of the clause product, reached after at least one step,
+    has every other hard clause satisfied and this one not.
+    """
+
+    def advance(state: tuple[str, ...], valuation: frozenset[str]) -> tuple[str, ...]:
+        return tuple(a.step(s, valuation) for a, s in zip(automata, state, strict=True))
+
+    def satisfied(state: tuple[str, ...], index: int) -> bool:
+        return automata[index].label(state[index]) is ClauseState.SATISFIED
+
+    start = tuple(a.initial for a in automata)
+    reached, queue = {start}, deque([start])
+    while queue:
+        state = queue.popleft()
+        for valuation in valuations:
+            following = advance(state, valuation)
+            if following not in reached:
+                reached.add(following)
+                queue.append(following)
+    after = reached - {start} | {advance(start, valuation) for valuation in valuations}
+
+    implied = [
+        i
+        for i in hard
+        if not any(
+            all(satisfied(state, j) for j in hard if j != i) and not satisfied(state, i)
+            for state in after
+        )
+    ]
+    if not implied:
+        return ["Redundant: none."]
+    return [
+        f"Redundant: R{i + 1} {_name(clauses[i])} is already implied by the other hard rules: "
+        "every run they accept keeps it, so the machine accepts the same runs without it."
+        for i in implied
+    ]
+
+
+class _Machine:
+    """The numbered Reward Machine with its implicit self-loops: no transition keeps the state."""
+
+    def __init__(self, machine: RewardMachineStructure, alphabet: Sequence[str]):
+        self.alphabet = alphabet
+        self.rows: dict[int, list] = {}
+        for transition in machine.transitions:
+            # A compiled machine has one guard per transition.
+            guard = parse_boolean_guard(transition.condition[0], alphabet)
+            self.rows.setdefault(transition.source, []).append((guard, transition.destination))
+
+    def step(self, state: int, valuation: frozenset[str]) -> int:
+        values = {proposition: proposition in valuation for proposition in self.alphabet}
+        for guard, destination in self.rows.get(state, ()):
+            if evaluate_boolean_guard(guard, values):
+                return destination
+        return state
+
+
+def _forced_line(
+    machine: RewardMachineStructure,
+    alphabet: Sequence[str],
+    valuations: Sequence[frozenset[str]],
+) -> str | None:
+    """Name the events every finishing run contains, or None when the machine cannot finish.
+
+    An event is forced when the final state cannot be reached on steps that leave it out. They
+    come in the order of the shortest finishing path, then by name.
+    """
+    final = machine.final_state
+    if final is None:
+        return None
+
+    # Every search reads the same (state, valuation) steps, and a machine state holds many guards.
+    step = cache(_Machine(machine, alphabet).step)
+    start = machine.initial_state
+
+    def at_final(state: int) -> bool:
+        return state == final
+
+    path = _walk(start, step, alphabet, valuations, at_final)
+    if not path:
+        return None
+
+    def finishes_without(event: str) -> bool:
+        kept = [valuation for valuation in valuations if event not in valuation]
+        return _bfs(start, step, kept, at_final) is not None
+
+    forced = [event for event in alphabet if not finishes_without(event)]
+    first_step: dict[str, int] = {}
+    for number, valuation in enumerate(path):
+        for event in valuation:
+            first_step.setdefault(event, number)
+    forced.sort(key=lambda event: (first_step[event], event))
+
+    return f"Every way to finish includes: {', '.join(forced) if forced else 'no single event'}."
+
+
+def critic_clues(
+    clauses: Sequence[ClauseProposal],
+    dfas: Sequence[dict],
+    reward_machine: RewardMachineStructure,
+) -> str:
+    """Write the clue block for one candidate, or "" when there is none to give.
+
+    Args:
+        clauses (Sequence[ClauseProposal]): The candidate's clauses, in proposal order.
+        dfas (Sequence[dict]): One compiled DFA per clause, in the same order.
+        reward_machine (RewardMachineStructure): The machine those clauses compiled to.
+
+    Returns:
+        str: One plain-words line per clause, then the redundant hard clauses (only with two or
+        more hard clauses), then the events every finishing run contains (only with a final state
+        that can be reached). Empty without clauses, or over ``MAX_PROPOSITIONS`` propositions.
+    """
+    alphabet = sorted({proposition for clause in clauses for proposition in clause.propositions})
+    if not clauses or len(alphabet) > MAX_PROPOSITIONS:
+        return ""
+
+    valuations = _valuations(alphabet)
+    automata = [_Dfa(dfa) for dfa in dfas]
+
+    lines = ["Rules in plain words:"]
+    for number, (clause, automaton) in enumerate(zip(clauses, automata, strict=True), start=1):
+        lines.append(_plain_line(number, clause, automaton, alphabet, valuations))
+
+    hard = [i for i, clause in enumerate(clauses) if clause.priority is PriorityLevel.HARD]
+    if len(hard) > 1:
+        lines += _redundant_lines(clauses, automata, hard, valuations)
+
+    forced_line = _forced_line(reward_machine, alphabet, valuations)
+    if forced_line:
+        lines.append(forced_line)
+    return "\n".join(lines)
