+) -> list[int]:
+    """Epsilon-greedy action per observation: one draw each, then one greedy pass for the rest."""
+    actions: list[int | None] = [None] * len(observations)
+    for index in range(len(observations)):
+        if epsilon > 0 and rng.random() < epsilon:
