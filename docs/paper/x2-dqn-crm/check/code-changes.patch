+    def counterfactual_transition(
+        self, state: str, observation: dict[str, np.ndarray], step: tuple
+    ) -> tuple[dict[str, np.ndarray], dict[str, np.ndarray], float, bool]:
+        """The replay transition RM state ``state`` would have stored for the real ``step``.
+
+        Counterfactual experience for Reward Machines (CRM, Toro Icarte et al., JAIR 2022): the
+        environment move and its true propositions are the real ones; the machine transition, the
+        reward with its end charge, the terminal flag and the encoding come from the wrapper's own
+        code.
+
+        Args:
+            state (str): The RM state to take the step from.
+            observation (dict[str, np.ndarray]): The observation the real step started from.
+            step (tuple): The real ``env.step`` result.
