REWARD_MACHINE:
STATES: u0, u1, u2
INITIAL_STATE: u0
FINAL_STATES:
REJECTING_STATES: u2
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, box_fell) -> u1
(u1, !box_fell&!holding_box) -> u2
(u1, !box_fell&holding_box) -> u0
(u1, box_fell&!holding_box) -> u2
REWARD_FUNCTION:
(u0, box_fell, u1) -> -1
(u1, !box_fell&!holding_box, u2) -> -10
(u1, !box_fell&holding_box, u0) -> 1
(u1, box_fell&!holding_box, u2) -> -10
