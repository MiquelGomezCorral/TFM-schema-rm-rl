REWARD_MACHINE:
STATES: u0, u1, u2
INITIAL_STATE: u0
FINAL_STATES: u2
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&!door_open&has_key) -> u1
(u0, at_goal&!door_open&!has_key) -> u2
(u0, at_goal&!door_open&has_key) -> u2
(u0, at_goal&door_open) -> u2
(u1, !at_goal&door_open) -> u0
(u1, at_goal&!door_open) -> u2
(u1, at_goal&door_open) -> u2
REWARD_FUNCTION:
(u0, at_goal&!door_open&!has_key, u2) -> 1.35
(u0, at_goal&!door_open&has_key, u2) -> 0.6
(u0, at_goal&door_open, u2) -> 1.35
(u1, at_goal&!door_open, u2) -> 0.6
(u1, at_goal&door_open, u2) -> 1.35
