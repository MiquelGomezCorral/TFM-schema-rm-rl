REWARD_MACHINE:
STATES: u0, u1, u2, u3, u4
INITIAL_STATE: u0
FINAL_STATES: u4
REJECTING_STATES: u3
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&!has_key&key_lost) -> u1
(u0, !at_goal&has_key&!key_lost) -> u2
(u0, !at_goal&has_key&key_lost) -> u3
(u0, at_goal&!has_key&!key_lost) -> u4
(u0, at_goal&!has_key&key_lost) -> u4
(u0, at_goal&has_key&!key_lost) -> u4
(u0, at_goal&has_key&key_lost) -> u3
(u1, !at_goal&has_key) -> u3
(u1, at_goal&!has_key) -> u4
(u1, at_goal&has_key) -> u3
(u2, !at_goal&key_lost) -> u3
(u2, at_goal&!key_lost) -> u4
(u2, at_goal&key_lost) -> u3
REWARD_FUNCTION:
(u0, !at_goal&!has_key&key_lost, u1) -> 0.1
(u0, !at_goal&has_key&!key_lost, u2) -> 0.1
(u0, !at_goal&has_key&key_lost, u3) -> -1
(u0, at_goal&!has_key&!key_lost, u4) -> 1.2
(u0, at_goal&!has_key&key_lost, u4) -> 1.2
(u0, at_goal&has_key&!key_lost, u4) -> 1.2
(u0, at_goal&has_key&key_lost, u3) -> -1
(u1, !at_goal&has_key, u3) -> -1
(u1, at_goal&!has_key, u4) -> 1.1
(u1, at_goal&has_key, u3) -> -1
(u2, !at_goal&key_lost, u3) -> -1
(u2, at_goal&!key_lost, u4) -> 1.1
(u2, at_goal&key_lost, u3) -> -1
