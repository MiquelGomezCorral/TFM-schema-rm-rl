REWARD_MACHINE:
STATES: u0, u1, u2, u3, u4
INITIAL_STATE: u0
FINAL_STATES: u4
REJECTING_STATES: u3
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !door_open&!has_key) -> u1
(u0, !door_open&has_key) -> u2
(u0, door_open&!has_key) -> u3
(u0, door_open&has_key) -> u4
(u1, !door_open&has_key) -> u2
(u1, door_open&!has_key) -> u3
(u1, door_open&has_key) -> u4
(u2, door_open) -> u4
REWARD_FUNCTION:
(u0, !door_open&has_key, u2) -> 0.1
(u0, door_open&!has_key, u3) -> -1
(u0, door_open&has_key, u4) -> 1.2
(u1, !door_open&has_key, u2) -> 0.1
(u1, door_open&!has_key, u3) -> -1
(u1, door_open&has_key, u4) -> 1.2
(u2, door_open, u4) -> 1.1
