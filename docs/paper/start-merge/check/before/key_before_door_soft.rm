REWARD_MACHINE:
STATES: u0, u1, u2, u3
INITIAL_STATE: u0
FINAL_STATES: u3
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !door_open&!has_key) -> u1
(u0, !door_open&has_key) -> u2
(u0, door_open&!has_key) -> u3
(u0, door_open&has_key) -> u3
(u1, !door_open&has_key) -> u2
(u1, door_open&!has_key) -> u3
(u1, door_open&has_key) -> u3
(u2, door_open) -> u3
REWARD_FUNCTION:
(u0, !door_open&has_key, u2) -> 0.1
(u0, door_open&!has_key, u3) -> 0.7
(u0, door_open&has_key, u3) -> 1.45
(u1, !door_open&has_key, u2) -> 0.1
(u1, door_open&!has_key, u3) -> 0.7
(u1, door_open&has_key, u3) -> 1.45
(u2, door_open, u3) -> 1.35
