REWARD_MACHINE:
STATES: u0, u1, u2, u3
INITIAL_STATE: u0
FINAL_STATES: u3
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&!door_open&!has_key) -> u1
(u0, !at_goal&!door_open&has_key) -> u2
(u0, !at_goal&door_open) -> u1
(u0, at_goal&!door_open&!has_key) -> u3
(u0, at_goal&!door_open&has_key) -> u3
(u0, at_goal&door_open) -> u3
(u1, !at_goal&!door_open&has_key) -> u2
(u1, at_goal&!door_open&!has_key) -> u3
(u1, at_goal&!door_open&has_key) -> u3
(u1, at_goal&door_open) -> u3
(u2, !at_goal&door_open) -> u1
(u2, at_goal&!door_open) -> u3
(u2, at_goal&door_open) -> u3
REWARD_FUNCTION:
(u0, at_goal&!door_open&!has_key, u3) -> 1.35
(u0, at_goal&!door_open&has_key, u3) -> 0.6
(u0, at_goal&door_open, u3) -> 1.35
(u1, at_goal&!door_open&!has_key, u3) -> 1.35
(u1, at_goal&!door_open&has_key, u3) -> 0.6
(u1, at_goal&door_open, u3) -> 1.35
(u2, at_goal&!door_open, u3) -> 0.6
(u2, at_goal&door_open, u3) -> 1.35
