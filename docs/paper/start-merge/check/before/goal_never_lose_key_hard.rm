REWARD_MACHINE:
STATES: u0, u1, u2, u3
INITIAL_STATE: u0
FINAL_STATES: u3
REJECTING_STATES: u2
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&!key_lost) -> u1
(u0, !at_goal&key_lost) -> u2
(u0, at_goal&!key_lost) -> u3
(u0, at_goal&key_lost) -> u2
(u1, !at_goal&key_lost) -> u2
(u1, at_goal&!key_lost) -> u3
(u1, at_goal&key_lost) -> u2
REWARD_FUNCTION:
(u0, !at_goal&key_lost, u2) -> -1
(u0, at_goal&!key_lost, u3) -> 1.1
(u0, at_goal&key_lost, u2) -> -1
(u1, !at_goal&key_lost, u2) -> -1
(u1, at_goal&!key_lost, u3) -> 1.1
(u1, at_goal&key_lost, u2) -> -1
