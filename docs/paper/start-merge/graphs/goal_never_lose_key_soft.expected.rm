REWARD_MACHINE:
STATES: u0, u1, u2
INITIAL_STATE: u0
FINAL_STATES: u2
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&key_lost) -> u1
(u0, at_goal&!key_lost) -> u2
(u0, at_goal&key_lost) -> u2
(u1, at_goal) -> u2
REWARD_FUNCTION:
(u0, !at_goal&key_lost, u1) -> -0.4
(u0, at_goal&!key_lost, u2) -> 1.45
(u0, at_goal&key_lost, u2) -> 0.7
(u1, at_goal, u2) -> 1.1
