{
  "serve-falls": {
    "label": "T1 serve + falls",
    "bundle": "shop-ladder-deliver",
    "task": "Whenever a client comes in, fetch food from the pantry and give it to them; if the food falls, pick it up on your very next move.",
    "clauses": [
      {
        "template": "Response",
        "args": [
          "client_arrived",
          "order_served"
        ],
        "priority": "hard",
        "ltlf_raw": "(G(client_arrived->(Forder_served)))",
        "ltlf": "(G (client_arrived -> (F order_served)))"
      },
      {
        "template": "ChainResponse",
        "args": [
          "food_fell",
          "holding_food"
        ],
        "priority": "hard",
        "ltlf_raw": "(G(food_fell->(Xholding_food)))",
        "ltlf": "(G (food_fell -> (X holding_food)))"
      }
    ]
  },
  "serve-siren": {
    "label": "T2 serve + siren",
    "bundle": "shop-ladder-deliver-siren",
