REWARD_MACHINE:
STATES: u0, u1, u2, u3
INITIAL_STATE: u0
FINAL_STATES:
REJECTING_STATES: u3
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !door_open&key_lost) -> u1
(u0, door_open&!key_lost) -> u2
(u0, door_open&key_lost) -> u3
(u1, door_open) -> u3
(u2, key_lost) -> u3
REWARD_FUNCTION:
(u0, door_open&key_lost, u3) -> -10
(u1, door_open, u3) -> -10
(u2, key_lost, u3) -> -10
