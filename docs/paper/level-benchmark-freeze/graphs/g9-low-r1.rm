REWARD_MACHINE:
STATES: u0, u1, u2, u3, u4, u5, u6
INITIAL_STATE: u0
FINAL_STATES: u4
REJECTING_STATES: u3
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !at_goal&!door_open&has_key) -> u1
(u0, !at_goal&door_open) -> u2
(u0, at_goal&!door_open&!has_key) -> u3
(u0, at_goal&!door_open&has_key) -> u3
(u0, at_goal&door_open) -> u4
(u1, !at_goal&door_open) -> u2
(u1, at_goal&!door_open) -> u3
(u1, at_goal&door_open) -> u4
(u2, !at_goal&!door_open&has_key) -> u5
(u2, at_goal&!door_open&!has_key) -> u4
(u2, at_goal&!door_open&has_key) -> u6
(u2, at_goal&door_open) -> u4
(u5, !at_goal&door_open) -> u2
(u5, at_goal&!door_open) -> u6
(u5, at_goal&door_open) -> u4
(u6, door_open) -> u4
REWARD_FUNCTION:
(u0, !at_goal&door_open, u2) -> 1
(u0, at_goal&!door_open&!has_key, u3) -> -10
(u0, at_goal&!door_open&has_key, u3) -> -10
(u0, at_goal&door_open, u4) -> 12
(u1, !at_goal&door_open, u2) -> 1
(u1, at_goal&!door_open, u3) -> -10
(u1, at_goal&door_open, u4) -> 12
(u2, !at_goal&!door_open&has_key, u5) -> -1
(u2, at_goal&!door_open&!has_key, u4) -> 11
(u2, at_goal&door_open, u4) -> 11
(u5, !at_goal&door_open, u2) -> 1
(u5, at_goal&!door_open, u6) -> 1
(u5, at_goal&door_open, u4) -> 12
(u6, door_open, u4) -> 11
