REWARD_MACHINE:
STATES: u0, u1, u2, u3
INITIAL_STATE: u0
FINAL_STATES: u3
REJECTING_STATES: u1
DEFAULT_REWARD: 0
TRANSITION_FUNCTION:
(u0, !has_door_key&target_picked_up) -> u1
(u0, has_door_key&!target_picked_up) -> u2
(u0, has_door_key&target_picked_up) -> u3
(u2, target_picked_up) -> u3
REWARD_FUNCTION:
(u0, !has_door_key&target_picked_up, u1) -> -10
(u0, has_door_key&!target_picked_up, u2) -> 1
(u0, has_door_key&target_picked_up, u3) -> 12
(u2, target_picked_up, u3) -> 11
